#!/bin/sh /etc/rc.common
# OpenWrt procd service script for SmartHome Edge Broker (MediaTek MT7986A ARM64)

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/smarthome-edge
CONF=/etc/smarthome-edge/config.json

start_service() {
    [ -f "$PROG" ] || return 1
    [ -f "$CONF" ] || return 1

    procd_open_instance
    procd_set_param command "$PROG" -config "$CONF"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
